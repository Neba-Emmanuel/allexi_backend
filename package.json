{
  "name": "@allexi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify": "npm run typecheck && npm test && npm run build",
    "prebuild": "node scripts/check-deployment.mjs",
    "check:vercel": "node --env-file-if-exists=.env scripts/check-deployment.mjs --vercel"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.0",
    "express": "^5.1.0",
    "cors": "^2.8.5",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.2",
    "@electric-sql/pglite": "^0.5.13",
    "tsx": "^4.20.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
