PORT=3001
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
CORS_ORIGINS=http://localhost:8081,http://localhost:8084,http://localhost:19006

# Server only. Required for account deletion; never put this in the mobile app.
SUPABASE_SERVICE_ROLE_KEY=
# Local direct server: 0. On Vercel, omit this variable to use the platform default (1).
# If you set it explicitly in Vercel, use 1 for the standard Vercel proxy.
TRUST_PROXY_HOPS=0
# Vercel Preview/Production enforce production validation automatically.
# Set NODE_ENV=production for other production hosts; requires HTTPS Supabase/CORS URLs.
NODE_ENV=development
