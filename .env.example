PORT=3001
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
CORS_ORIGINS=http://localhost:8081,http://localhost:8084,http://localhost:19006

# Server only. Required for account deletion; never put this in the mobile app.
SUPABASE_SERVICE_ROLE_KEY=
# Set exactly to the number of trusted reverse proxy hops (0 for a direct server).
TRUST_PROXY_HOPS=0
# Set NODE_ENV=production on your host; requires HTTPS Supabase/CORS URLs.
NODE_ENV=development
