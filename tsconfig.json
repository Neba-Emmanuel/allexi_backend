{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "index.ts",
    "src/**/*.ts",
    "shared/src/**/*.ts"
  ]
}
